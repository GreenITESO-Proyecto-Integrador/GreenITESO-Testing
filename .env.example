# Copiar a .env y llenar. .env NO se sube al repo.
BASE_URL=https://greeniteso.mocking.so
# Vacío = mismo origen que BASE_URL (nginx manda /api/ al backend)
# API_BASE_URL=
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000

# refresh: ambiente desplegado, login manual una vez por usuario (uv run python -m src.utils.auth --role <rol>)
# mock: stack local con el backend en MICROSOFT_AUTH_MODE=mock
AUTH_MODE=refresh
# Dónde se guardan las sesiones (fuera del repo). Default: ~/.greeniteso-e2e/auth
# AUTH_STATE_DIR=

# Cuentas de prueba @iteso.mx
TEST_STUDENT_EMAIL=qa.estudiante@iteso.mx
TEST_ADMIN_EMAIL=qa.admin@iteso.mx
TEST_LEADER_EMAIL=qa.lider@iteso.mx
TEST_CAMPAIGN_LEADER_EMAIL=qa.lider.campanas@iteso.mx
# Tienda: sus canjes no se deshacen; necesita saldo y artículos que aún no tenga
TEST_STORE_EMAIL=qa.tienda@iteso.mx
# Registro de acciones: cada corrida gasta parte de su límite diario por acción
TEST_ACTIONS_EMAIL=qa.acciones@iteso.mx

# Limpieza de datos de prueba al final de la corrida (true/false)
E2E_CLEANUP=true
